{
  "name": "nimbo",
  "version": "0.7.0",
  "description": "Un compañero flotante para Claude Code en Windows: ve qué hacen tus chats, aprueba permisos y habla con tu Claude",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "install-hooks": "node src/main/install-hooks.js",
    "uninstall-hooks": "node src/main/install-hooks.js --uninstall",
    "test": "node src/main/reminders.js && node src/integrations/whatsapp.js && node src/shared/i18n.js && node src/main/tts.js && node src/main/plan.js && node src/main/interview.js && node src/main/musicbar.js && node src/integrations/trello.js && node src/integrations/telegram.js && node src/integrations/spotify.js && node src/integrations/spotify-api.js && node src/integrations/media.js && node examples/tts-service/api/tts.js",
    "promo": "electron scripts/promo/promo-main.js",
    "dist": "electron-builder --win",
    "promo:gif": "electron scripts/promo/gif-main.js"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "gifenc": "^1.0.3"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0"
  },
  "license": "MIT",
  "author": "Federico Martínez",
  "keywords": [
    "claude-code",
    "electron",
    "companion",
    "windows",
    "hooks"
  ],
  "build": {
    "appId": "com.federicochalaca.nimbo",
    "productName": "Nimbo",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!scripts{,/**}",
      "!docs{,/**}",
      "!dist{,/**}",
      "!RESUMEN*",
      "!CLAUDE.md",
      "!README*",
      "!**/*.map",
      "!**/node_modules/onnxruntime-node{,/**}",
      "!**/node_modules/sharp{,/**}",
      "!**/node_modules/@img{,/**}",
      "!**/transformers.node.*",
      "!**/transformers.web.*",
      "!**/dist/transformers.js",
      "!build{,/**}",
      "!examples{,/**}",
      "!.github{,/**}",
      "!PRIVACY.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Nimbo-Setup.exe",
      "shortcutName": "Nimbo",
      "runAfterFinish": true
    }
  }
}
